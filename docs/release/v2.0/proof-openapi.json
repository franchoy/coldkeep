{
  "openapi": "3.0.3",
  "info": {
    "title": "Coldkeep internal fixture proof",
    "version": "2.0.0-dev.0",
    "description": "Action 2.02 only. One ephemeral bearer session; strict Host and same Origin for mutations. Synchronous restore; disconnect does not cancel work. No durable acceptance or safe automatic retry. Search/jobs/live GC unsupported."
  },
  "paths": {
    "/api/v1/session": {
      "post": {
        "operationId": "session",
        "security": [],
        "responses": {
          "200": {
            "description": "SessionResult",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResult"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "status",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history": {
      "get": {
        "operationId": "history",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "HistoryResult",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResult"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "enum": [
                32
              ]
            }
          }
        ]
      }
    },
    "/api/v1/restore": {
      "post": {
        "operationId": "restore",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "RestoreResult",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestoreResult"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "RestoreResult",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestoreResult"
                }
              }
            }
          },
          "422": {
            "description": "RestoreResult",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestoreResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "operationId": "search",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "501": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "operationId": "jobs",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "501": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "BootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "SessionResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "expires_seconds"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_seconds": {
            "type": "integer"
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "HistoryResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entries",
          "next_cursor"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "RestoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "RestoreResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "code",
          "detail"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "completed",
              "refused",
              "failed_or_partial"
            ]
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "history",
          "restore",
          "search",
          "jobs",
          "live_gc",
          "durable_acceptance"
        ],
        "properties": {
          "history": {
            "type": "boolean"
          },
          "restore": {
            "type": "boolean"
          },
          "search": {
            "type": "boolean"
          },
          "jobs": {
            "type": "boolean"
          },
          "live_gc": {
            "type": "boolean"
          },
          "durable_acceptance": {
            "type": "boolean"
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application",
          "api",
          "profile",
          "backend",
          "destination",
          "source_revision",
          "source_tree",
          "source_dirty",
          "asset_digest"
        ],
        "properties": {
          "application": {
            "type": "string"
          },
          "api": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "source_tree": {
            "type": "string"
          },
          "source_dirty": {
            "type": "boolean"
          },
          "asset_digest": {
            "type": "string"
          }
        }
      }
    }
  }
}
